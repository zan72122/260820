{
  "name": "suberidai-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "すべりだい研究所 — a WebGL slide-physics sandbox for 4-year-olds",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "simcheck": "esbuild scripts/simcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.simcheck.mjs --log-level=warning && node node_modules/.simcheck.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
