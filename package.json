{
  "name": "buttercream-flower-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A photoreal-leaning 3D buttercream flower piping game for iPhone and iPad, built with Three.js.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:smoke": "E2E_FAST=1 playwright test tests/smoke.spec.ts"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.185.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
