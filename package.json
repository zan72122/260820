{
  "name": "hikaru-kingyo-nebuta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ひかる金魚ねぶた — a mobile 3D web game about building and parading a kindergarten mini-nebuta",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2"
  }
}
