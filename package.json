{
  "name": "secret-inside-cake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Secret Inside Cake - a realistic WebGL pinata-cake game for very young players",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
